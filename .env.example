# Copy to .env and fill in. Never commit .env.

# --- Postgres (Canonical Fact Store) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=attrpipe
POSTGRES_USER=attrpipe
POSTGRES_PASSWORD=change-me

# --- RabbitMQ (queues between layers) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=attrpipe
RABBITMQ_PASSWORD=change-me

# --- MinIO (S3-compatible Raw Store) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=attrpipe
S3_SECRET_KEY=change-me-12chars
S3_BUCKET_RAW=raw-artifacts

# --- OpenSearch (BM25 / lexical index) ---
OPENSEARCH_URL=http://localhost:9200

# --- LLM (Tier 4 extraction, RAG generation) ---
ANTHROPIC_API_KEY=

# --- Proxies (optional, for fetchers) ---
PROXY_POOL_URL=

# --- Telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=attrpipe
LOG_LEVEL=INFO
